{
  "name": "gamming_bettle",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/server\" \"npm run dev -w apps/client\"",
    "server": "npm run dev -w apps/server",
    "client": "npm run dev -w apps/client",
    "build": "npm run build -w apps/client",
    "start": "npm run start -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
